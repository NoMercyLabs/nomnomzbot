# CLAUDE.md Critical Rule: "No Co-Authored-By in git commits — ever." AI assistant sessions have
# repeatedly added this trailer anyway, following a generic system-level convention that overrides
# the project's explicit instruction. This hook is the mechanical backstop: it rejects the commit
# outright instead of relying on every session remembering the rule.
#
# One-time setup per clone: git config core.hooksPath .githooks

if grep -qiE '^(Co-Authored-By|Claude-Session):' "$1"; then
    echo "commit rejected: message contains a Co-Authored-By or Claude-Session trailer." >&2
    echo "CLAUDE.md: \"No Co-Authored-By in git commits — ever.\" Remove the trailer and retry." >&2
    exit 1
fi
