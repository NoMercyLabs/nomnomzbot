#!/bin/sh
# Reject any commit message carrying an injected attribution trailer — wrapper.
# The repo kept its own commit-msg hook; it runs after this check, unchanged, as commit-msg.local.
dir=$(dirname "$0")
sh "$dir/commit-msg.guard" "$1" || exit $?
if [ -x "$dir/commit-msg.local" ] || [ -f "$dir/commit-msg.local" ]; then
  sh "$dir/commit-msg.local" "$1" || exit $?
fi
exit 0
