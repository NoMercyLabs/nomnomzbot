# A streamer SDK doc page lands only when every claim on it is verified and its slice is closed.
if git diff --cached --name-only --diff-filter=ACMR -- 'docs/sdk/*.md' 'docs/sdk/**/*.md' | grep -q .; then
  root=$(git rev-parse --show-toplevel)
  python "$root/scripts/check-sdk-docs.py" || {
    echo "pre-commit: docs/sdk pages failed the claim check (scripts/check-sdk-docs.py)." >&2
    exit 1
  }
fi
# V0: no added line may plan or add backwards-compat code (owner 2026-10-11).
python "$(git rev-parse --show-toplevel)/scripts/check-no-compat.py" || exit 1
exit 0
