# A streamer SDK doc page lands only when every claim on it is verified and its slice is closed.
if git diff --cached --name-only --diff-filter=ACMR -- 'docs/sdk/*.md' 'docs/sdk/**/*.md' | grep -q .; then
  root=$(git rev-parse --show-toplevel)
  python "$root/scripts/check-sdk-docs.py" || {
    echo "pre-commit: docs/sdk pages failed the claim check (scripts/check-sdk-docs.py)." >&2
    exit 1
  }
fi
# V0: no added line may plan or add backwards-compat code (owner 2026-10-11).
python "$(git rev-parse --show-toplevel)/scripts/check-no-compat.py" || exit 1
# Browser speech is gone; bot speech is server audio only (Stoney 2026-10-05, 2026-10-19).
if git diff --cached --name-only --diff-filter=ACMR -- 'server/src/*' 'dashboard/src/*' 'scripts/check-no-speech-synthesis.py' | grep -q .; then
  python "$(dirname "$0")/../scripts/check-no-speech-synthesis.py" "$(git rev-parse --show-toplevel)" || exit 1
fi
# Every table a live event handler writes gets a projection, so an import reaches it (owner 2026-10-12).
# core.hooksPath is absolute, so a worktree runs this hook; load the script beside the hook, not from the
# worktree, whose base may predate it. The script still reads the worktree's own files.
if git diff --cached --name-only --diff-filter=ACMRD -- 'server/src/*.cs' 'scripts/check-history-tables.py' | grep -q .; then
  python "$(dirname "$0")/../scripts/check-history-tables.py" || exit 1
fi
# Docs and comments are English; owner quotes are marked English translations (owner 2026-10-13).
staged=$(git diff --cached --name-only --diff-filter=ACMR -- 'CLAUDE.md' '.claude/docs/*' '.claude/skills/*' 'dashboard/src/*' 'scripts/*')
if [ -n "$staged" ]; then
  root=$(git rev-parse --show-toplevel)
  (cd "$root" && echo "$staged" | tr '\n' '\0' | xargs -0 python "$(dirname "$0")/../scripts/check-english-docs.py") || exit 1
fi
# A pipeline action or widget SDK change rewrites the widget typings; they land in the same commit (CI red twice 2026-10-19).
if git diff --cached --name-only --diff-filter=ACMRD -- 'server/src/*PipelineActions/*.cs' 'server/src/*Widgets/*.cs' | grep -q .; then
  root=$(git rev-parse --show-toplevel)
  dotnet test "$root/server/tests/NomNomzBot.Api.Tests" --filter "FullyQualifiedName~DashboardWidgetSdkTypesTests" --nologo -v q >/dev/null 2>&1 || {
    echo "pre-commit: dashboard/src/api/nnz-widget.d.ts is stale. Run the test with NNZ_WRITE_SDK_TYPES=1 and stage the file." >&2
    exit 1
  }
fi
exit 0
