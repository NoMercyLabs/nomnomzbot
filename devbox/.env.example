# Devbox configuration. Copy to devbox/.env (gitignored) and edit.
# This file configures the EDITOR container only - the bot's own settings still come from the
# repo-root .env.

# code-server login password. Set it; without one code-server writes a random password into
# ~/.config/code-server/config.yaml inside the container where you have to go dig for it.
DEVBOX_PASSWORD=change-me

# Ports on the host.
DEVBOX_PORT=8443
DEVBOX_SSH_PORT=2222
DEVBOX_API_PORT=5080
DEVBOX_WEB_PORT=5090

# VS Code Remote-SSH. 1 = start sshd (only if devbox/ssh/authorized_keys has a key in it).
DEVBOX_ENABLE_SSH=1

# Linux hosts: set these to `id -u` / `id -g` so the repo files the devbox writes stay yours.
DEVBOX_UID=1000
DEVBOX_GID=1000

# Memory ceiling for the box. Gradle + .NET builds are hungry; below ~6g the Kotlin daemon starts
# getting OOM-killed and the failure looks like a compiler crash.
DEVBOX_MEM_LIMIT=8g

# Git identity (name/email only - not a credential). Mounted read-only so commits made in the box
# are attributed to you. Windows hosts: ~ does not expand as you expect, give a full path.
#   DEVBOX_GITCONFIG=C:/Users/<you>/.gitconfig
DEVBOX_GITCONFIG=~/.gitconfig

# Credentials are created inside the box (`gh auth login`, `claude`), so each one is scoped to the
# box and revocable without touching your host.

TZ=Europe/Amsterdam
