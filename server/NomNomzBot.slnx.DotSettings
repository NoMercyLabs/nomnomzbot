<wpf:ResourceDictionary xml:space="preserve" xmlns:s="clr-namespace:System;assembly=mscorlib" xmlns:ss="urn:shemas-jetbrains-com:settings-storage-xaml" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wpf="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
	<s:String x:Key="/Default/CodeInspection/Highlighting/InspectionSeverities/=RedundantSuppressNullableWarningExpression/@EntryIndexedValue">WARNING</s:String>
	<s:String x:Key="/Default/CodeInspection/Highlighting/InspectionSeverities/=MergeIntoPattern/@EntryIndexedValue">WARNING</s:String>
	<s:String x:Key="/Default/CodeStyle/CodeCleanup/Profiles/=NomNomzBotCleanup/@EntryIndexedValue">&lt;Profile name="NomNomzBotCleanup"&gt;&lt;CSFixCodeIssues&gt;True&lt;/CSFixCodeIssues&gt;&lt;CSReformatCode&gt;False&lt;/CSReformatCode&gt;&lt;CSUseAutoProperty&gt;False&lt;/CSUseAutoProperty&gt;&lt;CSArrangeThisQualifier&gt;False&lt;/CSArrangeThisQualifier&gt;&lt;CSShortenReferences&gt;False&lt;/CSShortenReferences&gt;&lt;CSOptimizeUsings&gt;&lt;OptimizeUsings&gt;False&lt;/OptimizeUsings&gt;&lt;/CSOptimizeUsings&gt;&lt;CSUpdateFileHeader&gt;False&lt;/CSUpdateFileHeader&gt;&lt;CSMakeFieldReadonly&gt;False&lt;/CSMakeFieldReadonly&gt;&lt;CSArrangeQualifiers&gt;False&lt;/CSArrangeQualifiers&gt;&lt;CSArrangeCodeBodyStyle&gt;False&lt;/CSArrangeCodeBodyStyle&gt;&lt;CSharpFormatDocComments&gt;False&lt;/CSharpFormatDocComments&gt;&lt;CSMakeAutoPropertyGetOnly&gt;False&lt;/CSMakeAutoPropertyGetOnly&gt;&lt;RemoveRedundantAttributes&gt;False&lt;/RemoveRedundantAttributes&gt;&lt;/Profile&gt;</s:String>
</wpf:ResourceDictionary>
