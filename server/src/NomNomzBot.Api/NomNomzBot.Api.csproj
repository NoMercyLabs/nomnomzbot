<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>NomNomzBot.Api</RootNamespace>
    <!-- Feeds XML doc comments (controller /// <summary> etc.) into the built-in OpenAPI generator's
         compile-time source generator (Microsoft.AspNetCore.OpenApi.SourceGenerators) — see
         learn.microsoft.com/aspnet/core/fundamentals/openapi/openapi-comments. NoWarn'd for CS1591
         ("missing XML comment") since coverage is being filled in incrementally, not all at once;
         TreatWarningsAsErrors (Directory.Build.props) would otherwise fail the build on every
         undocumented public member. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Self-host `lite` single-file binary (deployment-distribution §1.1). Publish per-OS with, e.g.:
         dotnet publish src/NomNomzBot.Api -c Release -r win-x64   (or linux-x64 / linux-arm64 / osx-x64 / osx-arm64)
       PublishSingleFile + SelfContained are set here so the published artifact is ONE self-contained file named
       `nomnomz` — no .NET runtime install, no Docker. The native SQLite library (e_sqlite3) is bundled and
       self-extracted at first run; the embedded SQLite migration set ships via the Migrations.Sqlite project
       reference. These apply only on a self-contained RID publish, so framework-dependent Debug builds / the
       Docker image (UseAppHost=false) are unaffected. -->
  <PropertyGroup Condition="'$(SelfContained)' == 'true' and '$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Windows GUI subsystem so the self-host single binary runs WITHOUT a console window (the operator wanted no
         console for self-hosting). The bot is a background server: it logs to the data folder and surfaces a fatal
         startup error in a dialog (StartupErrorNotifier). No-op on Linux/macOS. Docker (UseAppHost=false) + dev are
         unaffected — they never hit this condition. -->
    <OutputType>WinExe</OutputType>
    <AssemblyName>nomnomz</AssemblyName>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- SQLitePCLRaw needs the e_sqlite3 native present; keep it as a bundled native, not trimmed/inlined. -->
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Globalization-invariant keeps the binary small and ICU-free; the bot's user-facing i18n is the frontend's,
         and the backend does no culture-sensitive formatting on the hot path. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Expose internal helpers (e.g. the dashboard activity actor-name resolver) to the Api test project so their
       behaviour can be unit-tested directly without exposing them on the public controller surface. -->
  <ItemGroup>
    <InternalsVisibleTo Include="NomNomzBot.Api.Tests" />
  </ItemGroup>

  <!-- The code-editor page (Assets/editor) is served at /editor from ContentRoot, NOT from the web root:
       wwwroot is build output (the Wasm bundle) and is gitignored, while these are committed source files.
       Copying them to the output directory keeps that path valid for publish and the Docker image too. -->
  <ItemGroup>
    <Content Include="Assets\editor\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The static landing page (Assets/landing) served at the exact root path for an anonymous visitor — same
       "committed source, not the gitignored wwwroot build output" reasoning as Assets/editor above. -->
  <ItemGroup>
    <Content Include="Assets\landing\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NomNomzBot.Application\NomNomzBot.Application.csproj" />
    <ProjectReference Include="..\NomNomzBot.Infrastructure\NomNomzBot.Infrastructure.csproj" />
    <!-- The SQLite migration set must ship in the api artifact (esp. the lite single-file binary) so
         IHost.MigrateAsync() can apply it at runtime. Referenced for deployment, not compile-time use. -->
    <ProjectReference Include="..\NomNomzBot.Migrations.Sqlite\NomNomzBot.Migrations.Sqlite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Asp.Versioning.Mvc" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <!-- Owned ids are UUIDv7 Guids in storage but ULID strings on the wire (Identifiers/) — encode/decode via the
         Cysharp Ulid type at the API boundary. -->
    <PackageReference Include="Ulid" />
  </ItemGroup>

  <!-- Bundle the compiled Vue dashboard into the published web root so the bot serves it (deployment-distribution
       §5 — single-origin). Opt-in via -p:BundleDashboard=true so ordinary build/test/publish stay Node-free; the
       self-host release publish sets it. Builds the dashboard (npm ci, then vite build with sign-in open), then
       copies dist/ into <publish>/wwwroot — which the runtime serves from the binary's own directory
       (ContentRoot/wwwroot). Runs AfterTargets=Publish so the files land in the publish output directly. -->
  <Target Name="BundleDashboard" AfterTargets="Publish" Condition="'$(BundleDashboard)' == 'true'">
    <PropertyGroup>
      <DashboardDir>$(MSBuildThisFileDirectory)../../../dashboard</DashboardDir>
    </PropertyGroup>
    <Message Importance="high" Text="BundleDashboard: building the Vue dashboard…" />
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(DashboardDir)" />
    <Exec
      Command="npm run build-only"
      WorkingDirectory="$(DashboardDir)"
      EnvironmentVariables="VITE_SIGN_IN_OPEN=true"
    />
    <ItemGroup>
      <DashboardFiles Include="$(DashboardDir)/dist/**/*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(DashboardFiles)"
      DestinationFiles="@(DashboardFiles-&gt;'$(PublishDir)wwwroot/%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
    />
    <Message
      Importance="high"
      Text="BundleDashboard: copied the dashboard into $(PublishDir)wwwroot."
    />
  </Target>
</Project>
