{
  "name": "bot.nomnomzbot.streamdeck.music",
  "version": "1.0.2",
  "private": true,
  "description": "NomNomzBot Stream Deck plugin — Spotify/music control over the bot's own Automation API",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "watch": "rollup -c rollup.config.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.1",
    "@elgato/utils": "0.5.0",
    "@nomnomzbot/streamdeck-shared": "1.0.0",
    "tslib": "^2.6.3"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^26.0.1",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/node": "^20.14.0",
    "rollup": "^4.18.0",
    "typescript": "^5.5.0",
    "vitest": "^4.0.0"
  }
}
