{
  "Name": "NomNomzBot OBS",
  "UUID": "bot.nomnomzbot.streamdeck.obs",
  "Version": "1.0.0",
  "Author": "NoMercy Labs",
  "Description": "Control OBS Studio through your bot's own Automation API — pairs itself, defaults to your self-hosted bot at localhost.",
  "Icon": "imgs/plugin/marketplace",
  "CodePath": "bin/plugin.js",
  "PropertyInspectorPath": "ui/settings.html",
  "SDKVersion": 2,
  "Software": { "MinimumVersion": "6.5" },
  "OS": [
    { "Platform": "windows", "MinimumVersion": "10" },
    { "Platform": "mac", "MinimumVersion": "10.15" }
  ],
  "Nodejs": { "Version": "20", "Debug": "enabled" },
  "Category": "NomNomzBot",
  "CategoryIcon": "imgs/plugin/category",
  "Actions": [
    {
      "Name": "Switch Scene",
      "UUID": "bot.nomnomzbot.streamdeck.obs.obs-switch-scene",
      "Icon": "imgs/actions/scene",
      "Tooltip": "Switches the active OBS scene to the one configured on this key.",
      "PropertyInspectorPath": "ui/scene-picker.html",
      "States": [{ "Image": "imgs/actions/scene" }]
    },
    {
      "Name": "Toggle Mute",
      "UUID": "bot.nomnomzbot.streamdeck.obs.obs-toggle-mute",
      "Icon": "imgs/actions/mic-mute",
      "Tooltip": "Mutes/unmutes the OBS audio input configured on this key.",
      "PropertyInspectorPath": "ui/input-picker.html",
      "States": [{ "Image": "imgs/actions/mic-mute" }]
    },
    {
      "Name": "Start Streaming",
      "UUID": "bot.nomnomzbot.streamdeck.obs.obs-start-streaming",
      "Icon": "imgs/actions/stream-start",
      "Tooltip": "Starts the OBS stream output.",
      "PropertyInspectorPath": "ui/appearance-only.html",
      "States": [{ "Image": "imgs/actions/stream-start" }]
    },
    {
      "Name": "Stop Streaming",
      "UUID": "bot.nomnomzbot.streamdeck.obs.obs-stop-streaming",
      "Icon": "imgs/actions/stream-stop",
      "Tooltip": "Stops the OBS stream output.",
      "PropertyInspectorPath": "ui/appearance-only.html",
      "States": [{ "Image": "imgs/actions/stream-stop" }]
    },
    {
      "Name": "Toggle Streaming",
      "UUID": "bot.nomnomzbot.streamdeck.obs.obs-toggle-streaming",
      "Icon": "imgs/actions/stream-start",
      "Tooltip": "Starts or stops the OBS stream output depending on its current state.",
      "PropertyInspectorPath": "ui/appearance-only.html",
      "States": [{ "Image": "imgs/actions/stream-start" }]
    },
    {
      "Name": "Start Recording",
      "UUID": "bot.nomnomzbot.streamdeck.obs.obs-start-recording",
      "Icon": "imgs/actions/record-start",
      "Tooltip": "Starts OBS recording.",
      "PropertyInspectorPath": "ui/appearance-only.html",
      "States": [{ "Image": "imgs/actions/record-start" }]
    },
    {
      "Name": "Stop Recording",
      "UUID": "bot.nomnomzbot.streamdeck.obs.obs-stop-recording",
      "Icon": "imgs/actions/record-stop",
      "Tooltip": "Stops OBS recording.",
      "PropertyInspectorPath": "ui/appearance-only.html",
      "States": [{ "Image": "imgs/actions/record-stop" }]
    },
    {
      "Name": "Toggle Recording",
      "UUID": "bot.nomnomzbot.streamdeck.obs.obs-toggle-recording",
      "Icon": "imgs/actions/record-start",
      "Tooltip": "Starts or stops OBS recording depending on its current state.",
      "PropertyInspectorPath": "ui/appearance-only.html",
      "States": [{ "Image": "imgs/actions/record-start" }]
    },
    {
      "Name": "Toggle Replay Buffer",
      "UUID": "bot.nomnomzbot.streamdeck.obs.obs-toggle-replay-buffer",
      "Icon": "imgs/actions/record-start",
      "Tooltip": "Starts or stops the OBS replay buffer depending on its current state.",
      "PropertyInspectorPath": "ui/appearance-only.html",
      "States": [{ "Image": "imgs/actions/record-start" }]
    },
    {
      "Name": "Toggle Virtual Camera",
      "UUID": "bot.nomnomzbot.streamdeck.obs.obs-toggle-virtual-cam",
      "Icon": "imgs/actions/device",
      "Tooltip": "Starts or stops the OBS virtual camera depending on its current state.",
      "PropertyInspectorPath": "ui/appearance-only.html",
      "States": [{ "Image": "imgs/actions/device" }]
    },
    {
      "Name": "Set Preview Scene",
      "UUID": "bot.nomnomzbot.streamdeck.obs.obs-set-preview-scene",
      "Icon": "imgs/actions/scene",
      "Tooltip": "Sets the studio-mode preview scene configured on this key.",
      "PropertyInspectorPath": "ui/scene-picker.html",
      "States": [{ "Image": "imgs/actions/scene" }]
    },
    {
      "Name": "Set Source Visibility",
      "UUID": "bot.nomnomzbot.streamdeck.obs.obs-set-source",
      "Icon": "imgs/actions/device",
      "Tooltip": "Shows or hides a source within a scene.",
      "PropertyInspectorPath": "ui/scene-source-picker.html",
      "States": [{ "Image": "imgs/actions/device" }]
    },
    {
      "Name": "Toggle Filter",
      "UUID": "bot.nomnomzbot.streamdeck.obs.obs-filter",
      "Icon": "imgs/actions/repeat",
      "Tooltip": "Enables or disables a filter on a source.",
      "PropertyInspectorPath": "ui/source-filter-picker.html",
      "States": [{ "Image": "imgs/actions/repeat" }]
    },
    {
      "Name": "Transition",
      "UUID": "bot.nomnomzbot.streamdeck.obs.obs-transition",
      "Icon": "imgs/actions/shuffle",
      "Tooltip": "Sets the current transition and/or fires a studio-mode transition.",
      "PropertyInspectorPath": "ui/transition-picker.html",
      "States": [{ "Image": "imgs/actions/shuffle" }]
    },
    {
      "Name": "Set Input Volume",
      "UUID": "bot.nomnomzbot.streamdeck.obs.obs-input-volume",
      "Icon": "imgs/actions/volume",
      "Tooltip": "Sets an input's volume to a fixed level in dB.",
      "PropertyInspectorPath": "ui/input-volume-picker.html",
      "States": [{ "Image": "imgs/actions/volume" }]
    },
    {
      "Name": "Media Control",
      "UUID": "bot.nomnomzbot.streamdeck.obs.obs-media",
      "Icon": "imgs/actions/play-pause",
      "Tooltip": "Plays, pauses, stops, restarts, or skips a media source.",
      "PropertyInspectorPath": "ui/media-picker.html",
      "States": [{ "Image": "imgs/actions/play-pause" }]
    },
    {
      "Name": "Fire Hotkey",
      "UUID": "bot.nomnomzbot.streamdeck.obs.obs-hotkey",
      "Icon": "imgs/actions/seek",
      "Tooltip": "Fires an OBS hotkey by its registered name.",
      "PropertyInspectorPath": "ui/simple-param.html",
      "States": [{ "Image": "imgs/actions/seek" }]
    },
    {
      "Name": "Refresh Browser Source",
      "UUID": "bot.nomnomzbot.streamdeck.obs.obs-refresh-browser",
      "Icon": "imgs/actions/previous",
      "Tooltip": "Reloads a browser source with no cache.",
      "PropertyInspectorPath": "ui/input-picker.html",
      "States": [{ "Image": "imgs/actions/previous" }]
    },
    {
      "Name": "Screenshot Source",
      "UUID": "bot.nomnomzbot.streamdeck.obs.obs-screenshot",
      "Icon": "imgs/actions/record-stop",
      "Tooltip": "Captures a source into the pipeline's obs.screenshot variable.",
      "PropertyInspectorPath": "ui/screenshot-picker.html",
      "States": [{ "Image": "imgs/actions/record-stop" }]
    },
    {
      "Name": "Save Replay Clip",
      "UUID": "bot.nomnomzbot.streamdeck.obs.obs-save-replay",
      "Icon": "imgs/actions/record-start",
      "Tooltip": "Saves the replay buffer as a clip.",
      "PropertyInspectorPath": "ui/appearance-only.html",
      "States": [{ "Image": "imgs/actions/record-start" }]
    },
    {
      "Name": "Raw OBS Request",
      "UUID": "bot.nomnomzbot.streamdeck.obs.obs-request",
      "Icon": "imgs/actions/device",
      "Tooltip": "Sends a raw obs-websocket request.",
      "PropertyInspectorPath": "ui/simple-param.html",
      "States": [{ "Image": "imgs/actions/device" }]
    },
    {
      "Name": "Call Vendor Request",
      "UUID": "bot.nomnomzbot.streamdeck.obs.obs-call-vendor",
      "Icon": "imgs/actions/device",
      "Tooltip": "Calls a third-party OBS-WS vendor plugin request.",
      "PropertyInspectorPath": "ui/simple-param.html",
      "States": [{ "Image": "imgs/actions/device" }]
    }
  ]
}
